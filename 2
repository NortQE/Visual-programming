<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D Snowfall Simulator" 
        Width="800" Height="600"
        WindowState="Maximized">
    <Grid Background="Black">
        <Viewport3D x:Name="Viewport">
            <Viewport3D.Camera>
                <PerspectiveCamera Position="0,0,20" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="60"/>
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#404040"/>
                        <DirectionalLight Color="#FFFFFF" Direction="-1,-1,-1"/>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Orientation="Horizontal" Margin="20">
            <Button Content="Add Snowflakes" Padding="10,5" Margin="5" Click="AddSnowflakes_Click"/>
            <Button Content="Clear All" Padding="10,5" Margin="5" Click="ClearAll_Click"/>
            <Label Content="Snowfall Speed:" Foreground="White" Margin="5"/>
            <Slider x:Name="SnowfallSpeedSlider" Minimum="0.1" Maximum="2" Value="1" Width="100" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
